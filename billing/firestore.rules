rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function approved(appId, uid) {
      let path = /databases/$(database)/documents/artifacts/$(appId)/access/$(uid);
      return exists(path) && get(path).data.active == true
        && (get(path).data.get('expiresAt', null) == null || get(path).data.expiresAt > request.time);
    }
    match /artifacts/{appId}/access/{uid} {
      allow get: if owner(uid);
      allow list, write: if false;
    }
    match /artifacts/{appId}/users/{uid} {
      allow get: if owner(uid);
      allow list, delete: if false;
      // Compatibilidade com cadastro antigo: nunca permite uma aprovação pelo cliente.
      allow create: if owner(uid)
        && request.resource.data.keys().hasOnly(['email', 'createdAt', 'accessCount', 'lifetimeAccess'])
        && request.resource.data.lifetimeAccess == false
        && request.resource.data.accessCount == 1;
      function bootstrapRetry() {
        return resource.data.lifetimeAccess == false && resource.data.accessCount == 1
          && request.resource.data.keys().hasOnly(['email', 'createdAt', 'accessCount', 'lifetimeAccess'])
          && request.resource.data.lifetimeAccess == false && request.resource.data.accessCount == 1
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.createdAt == request.time;
      }
      allow update: if owner(uid) && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['accessCount'])
          && request.resource.data.accessCount is int && request.resource.data.accessCount >= 1)
        || bootstrapRetry());
    }
    match /artifacts/{appId}/users/{uid}/notebooks/{notebookId} {
      allow read, delete: if owner(uid) && approved(appId, uid);
      allow create, update: if owner(uid) && approved(appId, uid)
        && request.resource.data.get('ownerUid', uid) == uid;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
