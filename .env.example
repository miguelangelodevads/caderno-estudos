# Ativar SOMENTE depois do backup, isenções e regras validadas.
VITE_BILLING_ENABLED=false
VITE_BILLING_API_URL=

# Cofre opcional: habilitar somente com Worker HTTPS e regras já publicados.
VITE_E2EE_ENABLED=false
VITE_DEVICE_API_URL=https://caderno-estudos-payments.migueltiojhoe.workers.dev/devices
VITE_USE_FIREBASE_EMULATORS=false

# URL pública do backend que mantém o access token do Mercado Pago fora do navegador
# Link de pagamento criado no painel do Mercado Pago
VITE_MERCADO_PAGO_PAYMENT_URL=https://www.mercadopago.com.br/checkout/v1/redirect?pref_id=SEU_LINK
# E-mail que receberá os comprovantes
VITE_PAYMENT_SUPPORT_EMAIL=seu-email@example.com
# WhatsApp para receber os comprovantes, somente números com código do país
VITE_PAYMENT_SUPPORT_WHATSAPP=5585987110571
